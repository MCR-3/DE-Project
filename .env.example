# Copy this file to .env and fill in the values.

# User id the Airflow containers run as. On Linux use `id -u`; on Windows/macOS 50000 is fine.
AIRFLOW_UID=50000

# Encrypts connection passwords stored in Airflow. Generate one with:
#   docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Docker network that DockerOperator tasks join, so that `project-db`, `project-mongo` and
# `project-redis` resolve from the launched containers. Leave empty for Docker's default; otherwise use the Compose network
# of this project (`docker network ls`, usually <folder-name>_default, e.g. de-project_default).
DOCKER_NETWORK=

# Absolute path of this repository's data/ folder ON THE HOST. DockerOperator containers are started
# by the host's Docker daemon, so bind mounts need a host path (used by the landing DAGs to write the
# raw files they scrape into data/landing/).
# Windows example: C:/Users/me/GitHub/DE-Project/data    Linux/macOS example: /home/me/DE-Project/data
HOST_DATA_DIR=

# Optional: User-Agent sent by the FSA and Ofsted scrapers (the landing DAGs). It is polite to give a way
# to contact you, e.g. "MyScraper/1.0 (you@example.com)". Defaults to one pointing at the repository.
# SCRAPER_USER_AGENT=

# Optional: admin account created by airflow-init (both default to "airflow").
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
